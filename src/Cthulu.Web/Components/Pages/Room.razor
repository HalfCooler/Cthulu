    private async Task SyncAsync()
    {
        _busy = true;
        try { await Game.SyncAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RejoinAsync()
    {
        await RunAsync(async () => await Game.JoinRoomAsync(_displayCode, _rejoinName));
    }

    private async Task RunAsync(Func<Task<CommandResult>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await action();
            if (!result.Ok)
            {
                // GameClientService already sets Toast; also capture client-side validation errors.
                CaptureToastFromGame();
                if (string.IsNullOrEmpty(_toastText))
                {
                    if (!string.IsNullOrEmpty(Game.LastError))
                    {
                        // already applied via CaptureToastFromGame when seq advanced
                    }
                    else if (!string.IsNullOrEmpty(_error))
                    {
                        ShowLocalToast(_error);
                    }
                    else
                    {
                        var text = string.IsNullOrEmpty(result.ErrorCode)
                            ? (result.Message ?? "操作失败")
                            : $"[{result.ErrorCode}] {result.Message}";
                        ShowLocalToast(text);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ShowLocalToast(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private static CommandResult CommandResultFail() =>
        new() { Ok = false, Message = "客户端校验失败" };

    private async Task ToggleLogTtsAsync(RoomView view)
    {
        try
        {
            if (_logSpeaking)
            {
                await Js.InvokeVoidAsync("cthuluTts.stop");
                _logSpeaking = false;
                return;
            }

            if (view.Log.Count == 0)
            {
                ShowLocalToast("暂无事件可播报");
                return;
            }

            // Chronological order (old → new) reads more naturally than UI reverse order.
            var lines = view.Log
                .Select(e => e.Message?.Trim())
                .Where(m => !string.IsNullOrEmpty(m))
                .Cast<string>()
                .ToList();

            if (lines.Count == 0)
            {
                ShowLocalToast("暂无事件可播报");
                return;
            }

            _ttsDotNetRef ??= DotNetObjectReference.Create(this);
            var result = await Js.InvokeAsync<LogTtsResult>("cthuluTts.speak", lines, "zh-CN", _ttsDotNetRef);
            if (result is null || !result.Ok)
            {
                _logSpeaking = false;
                ShowLocalToast(result?.Error ?? "语音播报失败");
                return;
            }

            _logSpeaking = true;
        }
        catch (JSDisconnectedException)
        {
            _logSpeaking = false;
        }
        catch (Exception ex)
        {
            _logSpeaking = false;
            ShowLocalToast($"语音播报失败：{ex.Message}");
        }
    }

    [JSInvokable]
    public void OnLogTtsEnded()
    {
        _logSpeaking = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Game.OnChange -= OnGameChanged;
        _toastCts?.Cancel();
        _toastCts?.Dispose();

        try
        {
            // Fire-and-forget stop; component is leaving the circuit.
            _ = Js.InvokeVoidAsync("cthuluTts.stop", false);
        }
        catch
        {
            /* ignore dispose-time JS failures */
        }

        _ttsDotNetRef?.Dispose();
        _ttsDotNetRef = null;
        _logSpeaking = false;
    }

    private sealed class LogTtsResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
    }
}
