    private async Task PassTradeAsync() => await RunAsync(() => Game.PassTradeAsync());

    private async Task ProposeTradeAsync()
    {
        await RunAsync(async () =>
        {
            if (string.IsNullOrEmpty(_tradeSellerId) || string.IsNullOrEmpty(_selectedRelicId))
            {
                _error = "请选择卖家祭品";
                return CommandResultFail();
            }
            if (_selectedGems.Count == 0)
            {
                _error = "请至少出价 1 张宝石";
                return CommandResultFail();
            }
            if (_selectedGems.Count > GameRules.MaxTradeDisplayGems)
            {
                _error = $"出价宝石张数不能超过 {GameRules.MaxTradeDisplayGems}";
                return CommandResultFail();
            }
            var result = await Game.ProposeTradeAsync(
                _tradeSellerId, _selectedRelicId, _selectedGems.ToList());
            if (result.Ok)
            {
                _selectedGems.Clear();
                _selectedRelicId = null;
                _tradeSellerId = null;
            }
            return result;
        });
    }

    private async Task RespondTradeAsync(bool accept) =>
        await RunAsync(() => Game.RespondTradeAsync(accept));

    private async Task CancelTradeAsync() => await RunAsync(() => Game.CancelTradeAsync());

    private async Task BeginForceBuyAsync() =>
        await RunAsync(async () =>
        {
            if (_selectedGems.Count > GameRules.MaxTradeDisplayGems)
            {
                _error = $"强买出价宝石张数不能超过 {GameRules.MaxTradeDisplayGems}";
                return CommandResultFail();
            }
            return await Game.BeginForceBuyAsync(_selectedGems.Count > 0 ? _selectedGems.ToList() : null);
        });

